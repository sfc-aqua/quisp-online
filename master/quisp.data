        Repeater3[0].quantum_port++ <--> QuantumChannel {  distance = 10km; } <--> BSA2[0].quantum_port++;
        BSA2[0].quantum_port++ <--> QuantumChannel {  distance = 10km; } <--> Repeater4[0].quantum_port++;//M<-10km->H<-10km->M

		//30km distance

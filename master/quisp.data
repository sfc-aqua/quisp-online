8KƒåçĞÑ`EİI␀;#!/bin/sh

BATIK_VERSION=1.14
BATIK_HOME=$HOME/local/batik-$BATIK_VERSION

BATIK_PP="java -jar ${BATIK_HOME}/batik-svgpp-${BATIK_VERSION}.jar"

for i in *.svg; do
  echo Pretty printing: $i
  ${BATIK_PP} $i $i.pp
  mv -f $i.pp $i
done
#!/bin/sh

# install svgcleaner from https://github.com/RazrFalcon/svgcleaner

for i in *.svg; do
  echo Converting: $i
  svgcleaner $i x/$i
done
#!/bin/sh

# modify according to teh local batik installation
BATIK_VERSION=1.14
BATIK_HOME=$HOME/local/batik-$BATIK_VERSION

BATIK="java -jar ${BATIK_HOME}/batik-rasterizer-${BATIK_VERSION}.jar"
CONVERT=convert

batik() {
  # $1=abstract,device,... $2=pixel size  $3=size suffix(_l,_s,...)
  $BATIK -w $2 -h $2 $1/*.svg
  mkdir -p png/$1
  for i in $1/*.png; do
     png=`echo $i | sed 's/\.png$//'`; png=png/$png$3.png
     $CONVERT -trim $i $png
     $CONVERT $png \( +clone -fill '#c0c0c0' -draw "color 0,0 reset" \) -compose Dst_Over -composite __tmp.png
     $CONVERT $png __tmp.png -compose In -composite $png
     rm $i
  done
  rm __tmp.png
}

batikall() {
  echo "Creating icons in size: $1"
  batik abstract $1 $2
  batik block $1 $2
  batik device $1 $2
  batik msg $1 $2
  batik misc $1 $2
  batik status $1 $2
}

mkdir -p png

batikall 100 _vl
batikall 60 _l
batikall 24 _s
batikall 16 _vs
batikall 40


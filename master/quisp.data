        Repeater9[0].quantum_port++ <--> QuantumChannel {  distance = 25km; } <--> BSA5[0].quantum_port++;
        BSA5[0].quantum_port++ <--> QuantumChannel {  distance = 25km; } <--> Repeater10[0].quantum_port++;//M<-20km->H<-20km->M


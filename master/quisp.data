        Repeater5[0].quantum_port++ <--> QuantumChannel {  distance = 15km; } <--> BSA3[0].quantum_port++;
        BSA3[0].quantum_port++ <--> QuantumChannel {  distance = 15km; } <--> Repeater6[0].quantum_port++;//M<-15km->H<-15km->M

		//40km distance
